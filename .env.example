# ─────────────────────────────────────────────────────────────
# CuePay Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# .env is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────
# Leave blank in development — PGLite runs automatically.
# In production (Neon / Vercel Postgres), paste the connection string.
DATABASE_URL=


# ── Auth ──────────────────────────────────────────────────────
# Random secret for signing session cookies.
# Generate one with:  openssl rand -hex 32
BETTER_AUTH_SECRET=

# The public URL of your deployed app (no trailing slash).
# In development this is set automatically.
BETTER_AUTH_URL=https://your-app.vercel.app


# ── M-Pesa Daraja API ─────────────────────────────────────────
# Get these from https://developer.safaricom.co.ke

# Environment: "sandbox" or "production"
MPESA_ENV=sandbox

# Consumer credentials from your Daraja app
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Shortcode (till number or paybill)
MPESA_SHORTCODE=

# Lipa Na M-Pesa passkey (from Daraja dashboard)
MPESA_PASSKEY=

# Public URL that Safaricom will POST the payment result to.
# Must be HTTPS and publicly reachable (not localhost).
# Example: https://your-app.vercel.app/api/mpesa/callback
MPESA_CALLBACK_URL=
